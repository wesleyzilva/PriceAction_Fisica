{ 
  Robo: FORCA_SEMAFORO_CORES_55
  Descricao: Coloração baseada em Forca > 55% para 60min, 30min e 15min
  Versao: 4.0
}

input
  VolumeMinimo(2000);
  PeriodoMediaVolume(20);
  ForcaMinimaEntrada(55); // O gatilho que você pediu
  HoraFechamento(170000);

var
  fCorpo, fRange, fVolMedia, fMassa, fAceleracao, fForca : float;

begin
  // --- Cálculos de Base ---
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;

  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  // --- Cálculo da Força ---
  fMassa := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca := fMassa * fAceleracao * 100;
  
  // Limites de segurança
  if fForca > 100 then fForca := 100;
  if fForca < -100 then fForca := -100;

  // --- LÓGICA DE CORES (DEGRADE RGB) ---
  // Todo candle começa cinza
  var r, g, b: integer;
  r := 128; g := 128; b := 128; // Cinza padrão

  // Indecisão: corpo pequeno (ex: < 10% do range)
  if (abs(fCorpo) < 0.1 * fRange) then
  begin
    r := 255; g := 255; b := 255; // Branco
  end
  // Compra: força positiva
  else if (fForca >= ForcaMinimaEntrada) then
  begin
    // Verde degradê: quanto maior a força, mais forte o verde
    g := 128 + round((fForca/100) * 127); // 128 a 255
    r := 128 - round((fForca/100) * 128); // 128 a 0
    b := 128 - round((fForca/100) * 128); // 128 a 0
    if g > 255 then g := 255;
    if r < 0 then r := 0;
    if b < 0 then b := 0;
  end
  // Venda: força negativa
  else if (fForca <= -ForcaMinimaEntrada) then
  begin
    // Vermelho degradê: quanto menor a força, mais forte o vermelho
    r := 128 + round((-fForca/100) * 127); // 128 a 255
    g := 128 - round((-fForca/100) * 128); // 128 a 0
    b := 128 - round((-fForca/100) * 128); // 128 a 0
    if r > 255 then r := 255;
    if g < 0 then g := 0;
    if b < 0 then b := 0;
  end
  // Senão, permanece cinza

  PaintBar(RGB(r, g, b));

  // --- SINAIS PARA O GERENCIADOR DE ALARMES ---
  // Usamos as funções de sinal para o Profit "gritar" no som
  if (fForca >= ForcaMinimaEntrada) and (not IsBought) entao BuyAtMarket;
  if (fForca <= -ForcaMinimaEntrada) and (not IsSold) entao SellShortAtMarket;

  // Fechamento por horário
  if Time() >= HoraFechamento then ClosePosition;
end;