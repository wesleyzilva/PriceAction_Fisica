{
  Robo: ROB_ATR7_VOLMA21_FORCA_REV
  Descricao: ATR(7) x Volume MA(21); reversao com peso de volume; entradas apenas se Forca >= ForcaMinimaEntrada
  Versao: 1.0
}

input
  VolumeMinimo(2000);
  PeriodoMediaVolume(21);
  MultVolumeReversao(2.0);
  ForcaMinimaEntrada(60);
  ForcaMinimaReversao(30);
  HoraFechamento(170000);
  ATRMultiplicador(2.0);
  ModoOperacao("AMBOS"); // "COMPRA", "VENDA" ou "AMBOS"

var
  fCorpo, fRange, fVolMedia, fMassa, fAceleracao, fForca : float;
  bRejeicao, bReversaoConfirmada, bRompCompra, bRompVenda : boolean;

begin
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;

  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  fMassa := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca := fMassa * fAceleracao * 100;
  if fForca > 100 then fForca := 100;
  if fForca < -100 then fForca := -100;

  bRejeicao := (High > High[1]) and (Low < Low[1]);
  bReversaoConfirmada := false;
  if bRejeicao then
  begin
    if (Volume >= VolumeMinimo) and (Volume >= fVolMedia * MultVolumeReversao) then
      bReversaoConfirmada := true;
  end;

  if bReversaoConfirmada then
    PaintBar(RGB(255,140,0))
  else
  begin
    if fForca >= 95 then PaintBar(RGB(0,100,0));           // Verde muito escuro
    if (fForca < 95) and (fForca >= 85) then PaintBar(RGB(0,180,0));      // Verde escuro
    if (fForca < 85) and (fForca >= 75) then PaintBar(RGB(0,220,0));      // Verde
    if (fForca < 75) and (fForca >= 65) then PaintBar(RGB(51,255,51));    // Verde médio escuro
    if (fForca < 65) and (fForca >= 55) then PaintBar(RGB(102,255,102));  // Verde médio
    if (fForca < 55) and (fForca >= 45) then PaintBar(RGB(153,255,153));  // Verde claro
    if (fForca < 45) and (fForca >= 35) then PaintBar(RGB(180,255,180));  // Verde muito claro
    if (fForca < 35) and (fForca >= 25) then PaintBar(RGB(210,255,210));  // Verde pálido
    if (fForca < 25) and (fForca >= 15) then PaintBar(RGB(230,255,230));  // Verde quase branco
    if (fForca < 15) and (fForca >= 5) then PaintBar(RGB(240,255,240));   // Verde-neutro
    if (fForca < 5) and (fForca > -5) then PaintBar(RGB(255,255,255));    // Neutro (branco)
    if (fForca <= -5) and (fForca > -15) then PaintBar(RGB(255,240,240)); // Vermelho-neutro
    if (fForca <= -15) and (fForca > -25) then PaintBar(RGB(255,220,220)); // Vermelho quase branco
    if (fForca <= -25) and (fForca > -35) then PaintBar(RGB(255,200,200)); // Vermelho pálido
    if (fForca <= -35) and (fForca > -45) then PaintBar(RGB(255,170,170)); // Vermelho muito claro
    if (fForca <= -45) and (fForca > -55) then PaintBar(RGB(255,140,140)); // Vermelho claro
    if (fForca <= -55) and (fForca > -65) then PaintBar(RGB(255,100,100)); // Vermelho médio
    if (fForca <= -65) and (fForca > -75) then PaintBar(RGB(255,60,60));   // Vermelho médio escuro
    if (fForca <= -75) and (fForca > -85) then PaintBar(RGB(220,0,0));     // Vermelho escuro
    if (fForca <= -85) and (fForca > -95) then PaintBar(RGB(180,0,0));     // Vermelho mais escuro
    if fForca <= -95 then PaintBar(RGB(120,0,0));         // Vermelho extremo
  end;

  bRompCompra := (Close > High[1]) and (Volume > VolumeMinimo) and (fForca >= ForcaMinimaEntrada);
  bRompVenda  := (Close < Low[1])  and (Volume > VolumeMinimo) and (fForca <= -ForcaMinimaEntrada);


  // Controle de modo de operação
  // ModoOperacao: "COMPRA" = só compra, "VENDA" = só venda, "AMBOS" = ambos
  if bReversaoConfirmada then
  begin
    if (ModoOperacao = "COMPRA") then
    begin
      if (Close > High[1]) and (fForca >= ForcaMinimaEntrada) and (not IsBought) then BuyAtMarket;
    end;
    if (ModoOperacao = "VENDA") then
    begin
      if (Close < Low[1]) and (fForca <= -ForcaMinimaEntrada) and (not IsBought) then SellShortAtMarket;
    end;
    if (ModoOperacao = "AMBOS") then
    begin
      if (Close > High[1]) and (fForca >= ForcaMinimaEntrada) and (not IsBought) then BuyAtMarket;
      if (Close < Low[1]) and (fForca <= -ForcaMinimaEntrada) and (not IsBought) then SellShortAtMarket;
    end;
  end
  else
  begin
    if (ModoOperacao = "COMPRA") then
    begin
      if bRompCompra and (not IsBought) then BuyAtMarket;
    end;
    if (ModoOperacao = "VENDA") then
    begin
      if bRompVenda  and (not IsBought) then SellShortAtMarket;
    end;
    if (ModoOperacao = "AMBOS") then
    begin
      if bRompCompra and (not IsBought) then BuyAtMarket;
      if bRompVenda  and (not IsBought) then SellShortAtMarket;
    end;
  end;

  if IsBought then
  begin
    if Low <= Close - (AvgTrueRange(7,0) * 1.5) then ClosePosition;
    if High >= Close + (AvgTrueRange(7,0) * ATRMultiplicador) then ClosePosition;
  end;

  if Time() >= HoraFechamento then ClosePosition;
end
